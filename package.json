{
  "name": "magpie-speed",
  "version": "0.1.0",
  "description": "Model speed measurements for Magpie: time to first token and output throughput per model and reasoning effort",
  "type": "module",
  "license": "MIT",
  "files": [
    "index.mjs",
    "hooks.mjs",
    "dist",
    "page",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --watch src/cli.ts --demo",
    "start": "bun src/cli.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test && bun run build",
    "format": "prettier --write src web scripts tests page *.json *.ts *.md",
    "prepack": "bun run build"
  },
  "magpie": {
    "hooks": "./hooks.mjs",
    "icon": "https://raw.githubusercontent.com/DBinK/magpie-speed/main/docs/icon.svg",
    "page": {
      "title": "Speed",
      "titles": {
        "zh": "模型测速"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 45890,
        "option": "port"
      }
    },
    "actions": [
      {
        "id": "speed",
        "menu": "provider",
        "title": "Speed test",
        "titles": {
          "zh": "测速"
        }
      }
    ],
    "options": {
      "port": 45890
    }
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@phosphor-icons/react": "^2.1.10"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DBinK/magpie-speed.git"
  },
  "bugs": {
    "url": "https://github.com/DBinK/magpie-speed/issues"
  }
}
